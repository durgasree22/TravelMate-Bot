+ "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>🏠 Starting From</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + current_location + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>👥 Number of Travelers</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + num_travelers + " Person(s)</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>🚗 Transport Mode</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + transport_display + "</td>" + "</tr>" + "<tr>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>📅 Travel Date</td>" + "<td style='padding: 12px 15px; color: #0066cc; font-size: 14px; font-weight: bold; text-align: right;'>" + travel_date + "</td>" + "</tr>" + "</table>" + "</div>" + "<div style='background: #f0f8ff; border: 2px solid #0066cc; border-radius: 8px; padding: 20px; margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 15px 0; font-size: 17px; color: #0066cc; text-align: center;'>🗺️ Your Preferred Travel Route & Itinerary</h3>" + "<div style='background: white; padding: 15px; border-radius: 5px; font-size: 13px; color: #333; line-height: 1.8;'>" + ai_itinerary_html + "</div>" + "</div>" + "<div style='background: #fff9e6; border: 1px solid #ffe082; border-radius: 8px; padding: 15px; margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 10px 0; font-size: 15px; color: #f57c00;'>📞 Your Contact Information</h3>" + "<p style='margin: 0 0 5px 0; font-size: 13px; color: #666;'>📧 <strong>Email:</strong> " + user_email + "</p>" + "<p style='margin: 0; font-size: 13px; color: #666;'>📱 <strong>Phone:</strong> " + user_phone + "</p>" + "</div>" + "<div style='background: #e3f2fd; border-left: 4px solid #2196F3; padding: 12px 15px; margin-bottom: 25px;'>" + "</div>" + "<div style='text-align: center; margin-bottom: 20px;'>" + "<a href='mailto:travelmate003004@gmail.com' style='display: inline-block; background: #0066cc; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-size: 14px; font-weight: bold;'>Contact Support</a>" + "</div>" + "<p style='font-size: 13px; color: #666; text-align: center; margin: 0;'>We're excited to help you plan the perfect trip!</p>" + "</div>" + "<div style='background: #333; padding: 20px; text-align: center;'>" + "<p style='margin: 0 0 5px 0; font-size: 13px; color: #999;'>Warm regards,</p>" + "<p style='margin: 0; font-size: 14px; color: white; font-weight: bold;'>Team TravelMate 🧳✈️</p>" + "<p style='margin: 15px 0 0 0; font-size: 11px; color: #666;'>© 2025 TravelMate. All rights reserved.</p>" + "</div>" + "</div>";
				email_payload = Map();
				personalizations = List();
				person = Map();
				to_list = List();
				to_map = Map();
				to_map.put("email",user_email);
				to_map.put("name",user_name);
				to_list.add(to_map);
				person.put("to",to_list);
				personalizations.add(person);
				email_payload.put("personalizations",personalizations);
				from_map = Map();
				from_map.put("email","travelmate003004@gmail.com");
				from_map.put("name","TravelMate");
				email_payload.put("from",from_map);
				email_payload.put("subject","🎉 Your Custom Itinerary - " + destination + " | " + itinerary_id);
				content_list = List();
				content_map = Map();
				content_map.put("type","text/html");
				content_map.put("value",html_content);
				content_list.add(content_map);
				email_payload.put("content",content_list);
				itinerary_response = invokeurl
				[
					url :"https://api.sendgrid.com/v3/mail/send"
					type :POST
					parameters:email_payload.toString()
					headers:{"Authorization":"Bearer " + sendgrid_api_key,"Content-Type":"application/json"}
				];
				info "Custom itinerary email with AI route sent successfully to: " + user_email;
				// Success response to user
				response.put("action","reply");
				response.put("replies",{"🎉 Perfect! Your custom itinerary with travel route has been sent to " + user_email + "! ✅\n\n📧 Itinerary Reference: " + itinerary_id + "\n📍 Destination: " + destination + "\n🗺️ Route: " + current_location + " → " + destination + "\n📅 Travel Date: " + travel_date + "\n👥 Travelers: " + num_travelers + "\n🚗 Transport: " + transport_display + "\n\nThank you for choosing TravelMate! Have a wonderful trip! 🌍✈️"});
				return response;
