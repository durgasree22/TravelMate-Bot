//PAYMENT VERIFICATION
if(context_id.startsWith("await_payment"))
{
	if(!answers.containsKey("payment_done"))
	{
		question = {"name":"payment_done","replies":{"Once you complete the payment, please type \"Done\".\n\nOr type \"Cancel Payment\" to cancel this transaction."},"input":{"type":"name","placeholder":"Type Done"},"suggestions":{"Done","Cancel Payment"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	done_text = answers.get("payment_done").get("text");
	if(done_text == "Cancel Payment")
	{
		parts = context_id.toList("__");
		if(parts.size() >= 3)
		{
			order_id = parts.get(1);
			payment_link_id = parts.get(2);
			try 
			{
				auth_string = razorpay_key_id + ":" + razorpay_key_secret;
				auth_header = "Basic " + zoho.encryption.base64Encode(auth_string);
				cancel_payload = Map();
				cancel_response = invokeurl
				[
					url :"https://api.razorpay.com/v1/payment_links/" + payment_link_id + "/cancel"
					type :POST
					parameters:cancel_payload.toString()
					headers:{"Authorization":auth_header,"Content-Type":"application/json"}
				];
				info "Payment link cancelled successfully: " + payment_link_id;
				base_context = context_id.subString(context_id.indexOf("__",context_id.indexOf("__") + 2) + 2);
				response.put("action","context");
				response.put("context_id","payment_cancelled__" + order_id + "__" + base_context);
				question = {"name":"after_cancel_choice","replies":{"❌ Payment Cancelled Successfully!\n\n🔖 Order ID: " + order_id + " has been cancelled.\n\nWhat would you like to do next?"},"suggestions":{"Retry Payment","End Chat"}};
				response.put("questions",{question});
				return response;
			}
			catch (e)
			{
				info "Error cancelling payment link: " + e;
				base_context = context_id.subString(context_id.indexOf("__",context_id.indexOf("__") + 2) + 2);
				response.put("action","context");
				response.put("context_id","payment_cancelled__" + order_id + "__" + base_context);
				question = {"name":"after_cancel_choice","replies":{"⚠️ Payment cancellation processed.\n\n🔖 Order ID: " + order_id + "\n\nWhat would you like to do next?"},"suggestions":{"Retry Payment","End Chat"}};
				response.put("questions",{question});
				return response;
			}
		}
	}
	if(done_text.toLowerCase() == "done")
	{
		parts = context_id.toList("__");
		if(parts.size() >= 3)
		{
			order_id = parts.get(1);
			payment_link_id = parts.get(2);
			payment_verified = false;
			payment_pending = false;
