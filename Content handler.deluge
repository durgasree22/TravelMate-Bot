			{
				auth_string = razorpay_key_id + ":" + razorpay_key_secret;
				auth_header = "Basic " + zoho.encryption.base64Encode(auth_string);
				if(payment_link_id != "NONE")
				{
					payment_status_response = invokeurl
					[
						url :"https://api.razorpay.com/v1/payment_links/" + payment_link_id
						type :GET
						headers:{"Authorization":auth_header}
					];
					if(payment_status_response.containsKey("status"))
					{
						status = payment_status_response.get("status");
						if(status == "paid")
						{
							payment_verified = true;
							info "Payment verified successfully for Order: " + order_id;
						}
						else if(status == "created" || status == "issued")
						{
							payment_pending = true;
						}
						else
						{
							response.put("action","reply");
							response.put("replies",{"❌ Payment " + status + "\n\nPlease try again or contact support.\n\nOrder ID: " + order_id});
							return response;
						}
					}
				}
				if(!payment_verified && !payment_pending)
				{
					order_status_response = invokeurl
					[
						url :"https://api.razorpay.com/v1/orders/" + order_id
						type :GET
						headers:{"Authorization":auth_header}
					];
					if(order_status_response.containsKey("status"))
					{
						order_status = order_status_response.get("status");
						if(order_status == "paid")
						{
							payment_verified = true;
							info "Order verified as paid: " + order_id;
						}
						else if(order_status == "created" || order_status == "attempted")
						{
							payment_pending = true;
						}
					}
				}
				if(payment_pending && !payment_verified)
				{
					response.put("action","context");
					response.put("context_id","payment_retry__" + context_id);
					question = {"name":"retry_payment","replies":{"⏳ Your payment is still processing.\n\nThis could mean:\n• Payment not yet completed\n• Payment gateway delay\n• Transaction in progress\n\nWould you like to:\n1️⃣ Wait and verify again\n2️⃣ Retry with a new payment link"},"suggestions":{"Verify Again","Retry Payment"}};
					response.put("questions",{question});
					return response;
				}
			}
