			pkg_desc = context_id.subString(desc_start,desc_end);
		}
		if(context_id.contains("PKGHOTEL:"))
		{
			hotel_start = context_id.indexOf("PKGHOTEL:") + 9;
			hotel_end = context_id.indexOf("||",hotel_start);
			if(hotel_end == -1)
			{
				hotel_end = context_id.length();
			}
			pkg_hotel = context_id.subString(hotel_start,hotel_end);
		}
		if(context_id.contains("TRIPTYPE:"))
		{
			type_start = context_id.indexOf("TRIPTYPE:") + 9;
			type_end = context_id.indexOf("||",type_start);
			if(type_end == -1)
			{
				type_end = context_id.length();
			}
			trip_type = context_id.subString(type_start,type_end);
		}
		html_content = "<div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f5f5f5;'>" + "<div style='background: linear-gradient(135deg, #0066cc 0%, #004a99 100%); padding: 30px 20px; text-align: center;'>" + "<div style='display: inline-block; margin-bottom: 10px;'>🧳</div>" + "<h1 style='color: white; margin: 0; font-size: 28px;'>TravelMate</h1>" + "<p style='color: #e0e0e0; margin: 5px 0 0 0; font-size: 14px;'>Your Journey Begins Here</p>" + "</div>" + "<div style='background: #4CAF50; padding: 15px; text-align: center;'>" + "<h2 style='color: white; margin: 0; font-size: 20px;'>✅ Booking Confirmed!</h2>" + "<p style='color: white; margin: 5px 0 0 0; font-size: 13px;'>Your trip is all set. Get ready for an amazing adventure!</p>" + "</div>" + "<div style='background: white; padding: 20px;'>" + "<p style='font-size: 15px; color: #333; margin: 0 0 20px 0;'>Dear <strong>" + user_name + "</strong>,</p>" + "<p style='font-size: 14px; color: #666; margin: 0 0 20px 0;'>Thank you for choosing TravelMate! We're excited to be part of your travel journey. Your booking has been confirmed and we're finalizing everything for your upcoming trip.</p>" + "<div style='background: #f9f9f9; border-left: 4px solid #0066cc; padding: 15px; margin-bottom: 25px;'>" + "<p style='margin: 0; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 1px;'>Booking Reference</p>" + "<p style='margin: 5px 0 0 0; font-size: 24px; color: #0066cc; font-weight: bold; letter-spacing: 1px;'>" + booking_id + "</p>" + "</div>" + "<div style='border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; margin-bottom: 25px;'>" + "<div style='background: #f8f8f8; padding: 12px 15px; border-bottom: 1px solid #e0e0e0;'>" + "<h3 style='margin: 0; font-size: 16px; color: #333;'>📋 Trip Details</h3>" + "</div>" + "<table style='width: 100%; border-collapse: collapse;'>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px; width: 40%;'>📍 Destination</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + destination + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>🎫 Package</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + pkg_title + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>🎒 Trip Type</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + trip_type + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>👥 Members</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + member_count + " Person(s)</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>📅 Travel Date</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + travel_date + "</td>" + "</tr>" + "<tr>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>💰 Total Amount</td>" + "<td style='padding: 12px 15px; color: #0066cc; font-size: 16px; font-weight: bold; text-align: right;'>₹" + final_price + "</td>" + "</tr>" + "</table>" + "</div>" + "<div style='background: #fffbf0; border: 1px solid #ffe082; border-radius: 8px; padding: 15px; margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 10px 0; font-size: 15px; color: #f57c00;'>✨ Package Highlights</h3>" + "<p style='margin: 0 0 8px 0; font-size: 13px; color: #666;'><strong>🗺️ Sightseeing:</strong> " + pkg_desc + "</p>" + "<p style='margin: 0; font-size: 13px; color: #666;'><strong>🏨 Accommodation:</strong> " + pkg_hotel + "</p>" + "</div>" + "<div style='background: #fff9e6; border: 1px solid #ffe082; border-radius: 8px; padding: 15px; margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 10px 0; font-size: 15px; color: #f57c00;'>📞 Your Contact Information</h3>" + "<p style='margin: 0 0 5px 0; font-size: 13px; color: #666;'>📧 <strong>Email:</strong> " + user_email + "</p>" + "<p style='margin: 0; font-size: 13px; color: #666;'>📱 <strong>Phone:</strong> " + user_phone + "</p>" + "</div>" + "<div style='background: #e3f2fd; border-left: 4px solid #2196F3; padding: 12px 15px; margin-bottom: 25px;'>" + "<p style='margin: 0; font-size: 13px; color: #1565C0;'><strong>💡 Important:</strong> Please keep this booking reference handy. Our team will contact you shortly with final itinerary and travel details!</p>" + "</div>" + "<div style='margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 12px 0; font-size: 16px; color: #333;'>✈️ What's Next?</h3>" + "<ul style='margin: 0; padding-left: 20px; color: #666; font-size: 13px; line-height: 1.8;'>" + "<li>Our travel expert will call you within 24 hours</li>" + "<li>You'll receive detailed itinerary via email</li>" + "<li>Payment options will be shared with you</li>" + "<li>24/7 support available throughout your journey</li>" + "</ul>" + "</div>" + "<div style='text-align: center; margin-bottom: 20px;'>" + "<a href='mailto:travelmate003004@gmail.com' style='display: inline-block; background: #0066cc; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-size: 14px; font-weight: bold;'>Contact Support</a>" + "</div>" + "<p style='font-size: 13px; color: #666; text-align: center; margin: 0 0 10px 0;'>We're thrilled to be part of your travel experience and committed to making it memorable. Safe travels!</p>" + "<p style='font-size: 13px; color: #666; text-align: center; margin: 0;'><strong>Warm Regards,</strong><br>Team TravelMate 🌍✈️</p>" + "</div>" + "<div style='background: #333; padding: 20px; text-align: center;'>" + "<p style='margin: 0 0 3px 0; font-size: 11px; color: #666;'>This is an automated confirmation email. Please do not reply to this email.</p>" + "<p style='margin: 0; font-size: 11px; color: #666;'>© 2025 TravelMate. All rights reserved.</p>" + "</div>" + "</div>";
		try 
		{
			sendgrid_api_key = "<SENDGRID_API_KEY>";
			email_payload = Map();
			personalizations = List();
			person = Map();
			to_list = List();
			to_map = Map();
			to_map.put("email",user_email);
			to_map.put("name",user_name);
			to_list.add(to_map);
			person.put("to",to_list);
			personalizations.add(person);
			email_payload.put("personalizations",personalizations);
			from_map = Map();
			from_map.put("email","travelmate003004@gmail.com");
			from_map.put("name","TravelMate");
			email_payload.put("from",from_map);
			email_payload.put("subject","🎉 Booking Confirmation - " + pkg_title + " | " + booking_id);
			content_list = List();
			content_map = Map();
			content_map.put("type","text/html");
			content_map.put("value",html_content);
			content_list.add(content_map);
			email_payload.put("content",content_list);
			confirmation_response = invokeurl
			[
				url :"https://api.sendgrid.com/v3/mail/send"
				type :POST
				parameters:email_payload.toString()
				headers:{"Authorization":"Bearer " + sendgrid_api_key,"Content-Type":"application/json"}
			];
			response.put("action","reply");
			response.put("replies",{"✅ Great! I've sent your booking confirmation to " + user_email + ". Please check your inbox for all the details about your trip to " + destination + "!\n\n🎫 Booking ID: " + booking_id + "\n\nIs there anything else I can help you with?"});
		}
		catch (e)
		{
			info "Email sending error: " + e;
			response.put("action","reply");
			response.put("replies",{"⚠️ I apologize, but there was an issue sending the email. However, here are your booking details:\n\n🎫 Booking ID: " + booking_id + "\n📍 Destination: " + destination + "\n📅 Travel Date: " + travel_date + "\n👥 Members: " + member_count + "\n💰 Total Amount: ₹" + final_price + "\n\nPlease save this information. Would you like me to try sending the email again?"});
		}
		return response;
	}
	else if(choice == "Want to explore again! Click here.")
	{
		response.put("action","context");
		response.put("context_id","main_menu");
		question = {"name":"main_choice","replies":{"🌍 Let's plan your next adventure! Where would you like to explore?"},"suggestions":{"Explore India","Explore International"}};
		response.put("questions",{question});
		return response;
	}
	else if(choice == "End chat")
	{
		response.put("action","reply");
		response.put("replies",{"Thank you for using TravelMate! Have a wonderful trip and feel free to reach out anytime. Safe travels! 🌍✈️"});
		return response;
	}
}
// DEFAULT FALLBACK
response.put("action","reply");
response.put("replies",{"I can only respond to the button options provided. Please use the buttons to continue."});
return response;
