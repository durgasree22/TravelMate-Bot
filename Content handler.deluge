					user_email = context_id.subString(email_start,email_end);
				}
				if(context_id.contains("PHONE:"))
				{
					phone_start = context_id.indexOf("PHONE:") + 6;
					phone_end = context_id.indexOf("||",phone_start);
					if(phone_end == -1)
					{
						phone_end = context_id.length();
					}
					user_phone = context_id.subString(phone_start,phone_end);
				}
				if(context_id.contains("TRAVELDATE:"))
				{
					date_start = context_id.indexOf("TRAVELDATE:") + 11;
