// INTERNATIONAL MEMBER COUNT
if(context_id.startsWith("intl_member_count_pre__"))
{
	if(!answers.containsKey("intl_member_count_pre"))
	{
		question = {"name":"intl_member_count_pre","replies":{"Please enter the number of members."},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	
	trip_type = context_id.replaceAll("intl_member_count_pre__","");
	member_text = answers.get("intl_member_count_pre").get("text");
	
	try 
	{
		member_count = member_text.toNumber();
		if(member_count < 1 || member_count > 20)
		{
			question = {"name":"intl_member_count_pre","replies":{"Please enter a number between 1 and 20."},"input":{"type":"name","placeholder":"e.g., 4"}};
			response.put("action","context");
			response.put("context_id",context_id);
			response.put("questions",{question});
			return response;
		}
	}
	catch (e)
	{
		question = {"name":"intl_member_count_pre","replies":{"Please enter a valid number."},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
