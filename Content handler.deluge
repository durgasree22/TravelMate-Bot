			travel_date = context_id.subString(date_start,date_end);
		}
		if(context_id.contains("MEMBERCOUNT:"))
		{
			mem_start = context_id.indexOf("MEMBERCOUNT:") + 12;
			mem_end = context_id.indexOf("||",mem_start);
			if(mem_end == -1)
			{
				mem_end = context_id.length();
			}
			member_count = context_id.subString(mem_start,mem_end);
		}
		if(context_id.contains("FINALPRICE:"))
		{
			price_start = context_id.indexOf("FINALPRICE:") + 11;
			price_end = context_id.indexOf("||",price_start);
			if(price_end == -1)
			{
				price_end = context_id.length();
			}
			final_price = context_id.subString(price_start,price_end);
		}
		if(context_id.contains("PKGTITLE:"))
		{
			title_start = context_id.indexOf("PKGTITLE:") + 9;
			title_end = context_id.indexOf("||",title_start);
			if(title_end == -1)
			{
				title_end = context_id.length();
			}
			pkg_title = context_id.subString(title_start,title_end);
		}
		if(context_id.contains("PKGDESC:"))
		{
			desc_start = context_id.indexOf("PKGDESC:") + 8;
			desc_end = context_id.indexOf("||",desc_start);
