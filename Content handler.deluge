			destination = context_id.subString(dest_start,dest_end);
		}
		if(context_id.contains("TRAVELDATE:"))
		{
			date_start = context_id.indexOf("TRAVELDATE:") + 11;
			date_end = context_id.indexOf("||",date_start);
			if(date_end == -1)
			{
				date_end = context_id.length();
