					user_name = context_id.subString(name_start,name_end);
				}
				if(context_id.contains("EMAIL:"))
				{
					email_start = context_id.indexOf("EMAIL:") + 6;
					email_end = context_id.indexOf("||",email_start);
					if(email_end == -1)
					{
						email_end = context_id.length();
