				response.put("action","reply");
				response.put("replies",{"⚠️ Your itinerary details have been recorded, but there was an issue sending the email.\n\n📧 Reference ID: " + itinerary_id + "\n📍 Destination: " + destination + "\n📅 Travel Date: " + travel_date + "\n\nOur team will contact you shortly at " + user_phone + ". You can also reach us at travelmate003004@gmail.com"});
				return response;
			}
		}
		else
