		base_price = 75000;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/thailand%20image_converted.jpg";
	}
	else if(selected_action == "BookVietnam")
	{
		place = "Vietnam";
		pkg_title = "Vietnam Heritage";
		pkg_duration = "5N/6D";
		pkg_sightseeing = "Ha Long Bay Cruise, Hanoi Old Quarter, Hoi An Ancient Town";
		pkg_stay = "Heritage Hotel + Cruise";
		pkg_meals = "All meals included";
		base_price = 78000;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/vietnam_converted.jpg";
	}
	
	final_price = base_price * member_count;
	pkg_details = pkg_duration + " • ₹" + final_price + " total\n\n📍 " + pkg_sightseeing + "\n🏨 " + pkg_stay + "\n🍴 " + pkg_meals + "\n👥 " + member_count + " member(s)";
	
	next_context = "post_pricing__INTL__" + place + "__" + trip_type + "__" + final_price + "__" + member_count;
	response.put("action","context");
	response.put("context_id",next_context);
	
	question = {"name":"post_price_confirmation","replies":{{"type":"image","image":pkg_image,"text":pkg_title},{"text":pkg_details},{"text":"Would you like to proceed with booking?"}},"suggestions":{"Continue Booking","Cancel"}};
	response.put("questions",{question});
	return response;
}

