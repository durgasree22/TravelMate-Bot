			{
				email_end = context_id.length();
			}
			user_email = context_id.subString(email_start,email_end);
		}
		if(context_id.contains("NAME:"))
		{
			name_start = context_id.indexOf("NAME:") + 5;
			name_end = context_id.indexOf("||",name_start);
			if(name_end == -1)
			{
				name_end = context_id.length();
			}
			user_name = context_id.subString(name_start,name_end);
		}
		if(context_id.contains("PHONE:"))
		{
