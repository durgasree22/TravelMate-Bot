response = Map();
context_id = ifnull(context_id,"");
answers = ifnull(answers,Map());
// JOURNEY TYPE SELECTION
if(context_id == "journey_type_selection")
{
	if(!answers.containsKey("journey_type"))
	{
		question = {"name":"journey_type","replies":{"How would you like to plan your trip?\nChoose 'Explore Destinations' for fixed tour packages.\nChoose 'Plan an Itinerary' for custom tour package selection."},"suggestions":{"Explore Destinations","Plan an Itinerary"}};
		response.put("action","context");
		response.put("context_id","journey_type_selection");
		response.put("questions",{question});
		return response;
	}
	journey_choice = answers.get("journey_type").get("text");
	if(journey_choice == "Explore Destinations")
	{
		response.put("action","context");
		response.put("context_id","main_menu");
		question = {"name":"main_choice","replies":{"Desi Vibes or Global Adventures? 🌍"},"suggestions":{"Explore India","Explore International"}};
		response.put("questions",{question});
		return response;
	}
	else if(journey_choice == "Plan an Itinerary")
	{
		response.put("action","context");
		response.put("context_id","custom_itinerary_start");
		question = {"name":"start_custom","replies":{"Perfect! Let's create a custom itinerary just for you! 🗺️\n\nI'll need some details to plan the perfect trip."},"suggestions":{"Let's Start!"}};
		response.put("questions",{question});
		return response;
	}
	else
	{
		question = {"name":"journey_type","replies":{"Please use the buttons to select an option."},"suggestions":{"Explore Destinations","Plan an Itinerary"}};
		response.put("action","context");
		response.put("context_id","journey_type_selection");
		response.put("questions",{question});
		return response;
	}
}
// MAIN MENU
if(context_id == "main_menu")
{
	if(!answers.containsKey("main_choice"))
	{
		question = {"name":"main_choice","replies":{"Desi Vibes or Global Adventures? 🌍"},"suggestions":{"Explore India","Explore International"}};
		response.put("action","context");
		response.put("context_id","main_menu");
		response.put("questions",{question});
		return response;
	}
	main_choice = answers.get("main_choice").get("text");
	if(main_choice == "Explore India")
	{
		response.put("action","context");
		response.put("context_id","india_trip_type_selection");
		question = {"name":"india_trip_type_pre","replies":{"Desi Vibes! 🇮🇳\n\nFirst, tell me who's traveling?"},"suggestions":{"Solo Trip","Couple Trip","Family Trip","Friends Trip"}};
		response.put("questions",{question});
		return response;
	}
	else if(main_choice == "Explore International")
	{
		response.put("action","context");
		response.put("context_id","intl_trip_type_selection");
		question = {"name":"intl_trip_type_pre","replies":{"Going Global! ✈️\n\nFirst, tell me who's traveling?"},"suggestions":{"Solo Trip","Couple Trip","Family Trip","Friends Trip"}};
		response.put("questions",{question});
		return response;
	}
	else
	{
		question = {"name":"main_choice","replies":{"Please use the buttons to select an option."},"suggestions":{"Explore India","Explore International"}};
		response.put("action","context");
		response.put("context_id","main_menu");
		response.put("questions",{question});
		return response;
	}
}
// CUSTOM ITINERARY FLOW
if(context_id == "custom_itinerary_start")
{
	if(!answers.containsKey("start_custom"))
	{
		question = {"name":"start_custom","replies":{"Perfect! Let's create a custom itinerary just for you! 🗺️\n\nI'll need some details to plan the perfect trip."},"suggestions":{"Let's Start!"}};
		response.put("action","context");
		response.put("context_id","custom_itinerary_start");
		response.put("questions",{question});
		return response;
	}
	response.put("action","context");
	response.put("context_id","custom_travelers");
	question = {"name":"num_travelers","replies":{"How many people will be traveling? 👥\n\n(Enter a number between 1-20)"},"input":{"type":"name","placeholder":"e.g., 4"}};
	response.put("questions",{question});
	return response;
}
// CUSTOM ITINERARY - COLLECT NUMBER OF TRAVELERS
if(context_id == "custom_travelers")
{
	if(!answers.containsKey("num_travelers"))
	{
		question = {"name":"num_travelers","replies":{"Please enter the number of travelers."},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id","custom_travelers");
		response.put("questions",{question});
		return response;
	}
	travelers_text = answers.get("num_travelers").get("text");
	try 
	{
		num_travelers = travelers_text.toNumber();
	}
	catch (e)
	{
		question = {"name":"num_travelers","replies":{"Please enter a valid number (e.g., 4)"},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id","custom_travelers");
		response.put("questions",{question});
		return response;
	}
	if(num_travelers < 1 || num_travelers > 20)
	{
		question = {"name":"num_travelers","replies":{"Please enter a number between 1 and 20."},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id","custom_travelers");
		response.put("questions",{question});
		return response;
	}
	response.put("action","context");
	response.put("context_id","custom_destination__" + num_travelers);
	question = {"name":"destination","replies":{"Great! " + num_travelers + " traveler(s) noted. ✅\n\nWhere would you like to go? 🌍\n\n(Enter your dream destination)"},"input":{"type":"name","placeholder":"e.g., Paris, Goa, Manali"}};
	response.put("questions",{question});
	return response;
}
// CUSTOM ITINERARY - COLLECT DESTINATION
if(context_id.startsWith("custom_destination__") && context_id.indexOf("__",20) == -1)
{
	if(!answers.containsKey("destination"))
	{
		question = {"name":"destination","replies":{"Where would you like to go? 🌍\n\n(Enter your dream destination)"},"input":{"type":"name","placeholder":"e.g., Paris, Goa, Manali"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	num_travelers = context_id.replaceAll("custom_destination__","");
	destination = answers.get("destination").get("text");
	response.put("action","context");
	response.put("context_id","custom_current_location__" + num_travelers + "__" + destination);
	question = {"name":"current_location","replies":{"Perfect! " + destination + " sounds amazing! 🎯\n\nWhat is your current location? 📍\n\n(This helps us plan the best route for you)"},"input":{"type":"name","placeholder":"e.g., Delhi, Mumbai, Bangalore"}};
	response.put("questions",{question});
	return response;
}
// CUSTOM ITINERARY - COLLECT CURRENT LOCATION & AI ROUTE ANALYSIS
if(context_id.startsWith("custom_current_location"))
{
	if(!answers.containsKey("current_location"))
	{
		question = {"name":"current_location","replies":{"What is your current location? 📍\n\n(This helps us plan the best route for you)"},"input":{"type":"name","placeholder":"e.g., Delhi, Mumbai, Bangalore"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	parts = context_id.replaceAll("custom_current_location__","").toList("__");
	num_travelers = parts.get(0);
	destination = parts.get(1);
	current_location = answers.get("current_location").get("text");
	
	groq_api_key = "<GROQ_API_KEY>";
	route_prompt = "Analyze the journey from " + current_location + " to " + destination + ". Provide a brief route analysis covering: estimated distance, travel time, public transport availability (trains/buses), and private transport options (car/taxi). Keep response under 200 words.";
	
	try 
	{
		groq_payload = Map();
		groq_payload.put("model","llama-3.1-8b-instant");
		messages_list = List();
		message_map = Map();
		message_map.put("role","user");
		message_map.put("content",route_prompt);
		messages_list.add(message_map);
		groq_payload.put("messages",messages_list);
		groq_payload.put("max_tokens",300);
		groq_payload.put("temperature",0.7);
		
		groq_response = invokeurl
		[
			url :"https://api.groq.com/openai/v1/chat/completions"
			type :POST
			parameters:groq_payload.toString()
			headers:{"Authorization":"Bearer " + groq_api_key,"Content-Type":"application/json"}
		];
		
		if(groq_response.containsKey("choices") && groq_response.get("choices").size() > 0)
		{
			choice = groq_response.get("choices").get(0);
			if(choice.containsKey("message") && choice.get("message").containsKey("content"))
			{
				ai_analysis = choice.get("message").get("content");
				next_context = "custom_transport_choice__" + num_travelers + "__" + destination + "__" + current_location;
				response.put("action","context");
				response.put("context_id",next_context);
				question = {"name":"transport_choice","replies":{"📊 Route Analysis:\n\n" + ai_analysis + "\n\n🚗 How would you like to travel?"},"suggestions":{"Public Transport","Private Transport"}};
				response.put("questions",{question});
				return response;
			}
		}
	
		next_context = "custom_transport_choice__" + num_travelers + "__" + destination + "__" + current_location;
		response.put("action","context");
		response.put("context_id",next_context);
		question = {"name":"transport_choice","replies":{"Great! Now let's plan your journey from " + current_location + " to " + destination + ". 🗺️\n\n🚗 How would you like to travel?"},"suggestions":{"Public Transport","Private Transport"}};
		response.put("questions",{question});
		return response;
	}
	catch (e)
	{
		info "Groq API Error: " + e;
		next_context = "custom_transport_choice__" + num_travelers + "__" + destination + "__" + current_location;
		response.put("action","context");
		response.put("context_id",next_context);
		question = {"name":"transport_choice","replies":{"Great! Now let's plan your journey from " + current_location + " to " + destination + ". 🗺️\n\n🚗 How would you like to travel?"},"suggestions":{"Public Transport","Private Transport"}};
		response.put("questions",{question});
		return response;
	}
}
// CUSTOM TRANSPORT CHOICE - ASK FOR DAYS (NEW STEP)
if(context_id.startsWith("custom_transport_choice__"))
{
	if(!answers.containsKey("transport_choice"))
	{
		question = {"name":"transport_choice","replies":{"Please select how you'd like to travel."},"suggestions":{"Public Transport","Private Transport"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	
	transport_type = answers.get("transport_choice").get("text");

	transport_code = "";
	if(transport_type == "Public Transport") { transport_code = "PublicTransport"; }
	else { transport_code = "PrivateTransport"; }
	
	parts = context_id.replaceAll("custom_transport_choice__","").toList("__");
	num_travelers = parts.get(0);
	destination = parts.get(1);
	current_location = parts.get(2);
	
	next_context = "custom_days_selection__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_code;
	
	response.put("action","context");
	response.put("context_id",next_context);
	question = {"name":"trip_days","replies":{"✅ Transport selected: " + transport_type + "\n\n📅 How many days are you planning for this trip?\n(e.g., 3, 5, 7)"},"input":{"type":"name","placeholder":"e.g., 5"}};
	response.put("questions",{question});
	return response;
}
// CUSTOM DAYS SELECTION - GENERATE ITINERARY (NEW HANDLER)
if(context_id.startsWith("custom_days_selection__"))
{
	if(!answers.containsKey("trip_days"))
	{
		question = {"name":"trip_days","replies":{"Please enter the number of days for your trip."},"input":{"type":"name","placeholder":"e.g., 5"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	
	days_text = answers.get("trip_days").get("text");
	try 
	{
		num_days = days_text.toNumber();
		if(num_days < 1 || num_days > 30)
		{
			question = {"name":"trip_days","replies":{"Please enter a duration between 1 and 30 days."},"input":{"type":"name","placeholder":"e.g., 5"}};
			response.put("action","context");
			response.put("context_id",context_id);
			response.put("questions",{question});
			return response;
		}
	}
	catch (e)
	{
		question = {"name":"trip_days","replies":{"Please enter a valid number of days."},"input":{"type":"name","placeholder":"e.g., 5"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	
	parts = context_id.replaceAll("custom_days_selection__","").toList("__");
	num_travelers = parts.get(0);
	destination = parts.get(1);
	current_location = parts.get(2);
	transport_code = parts.get(3);
	transport_readable = "Private Transport (Car/Taxi)";
	if(transport_code == "PublicTransport") { transport_readable = "Public Transport (Train/Bus)"; }
	
	groq_api_key = "<GROQ_API_KEY>";
	
	itinerary_prompt = "Create a detailed " + num_days + "-day travel itinerary from " + current_location + " to " + destination + " for " + num_travelers + " travelers using " + transport_readable + ". Include:\n1. Day-by-day activities\n2. Transport details\n3. Estimated budget range in INR\n4. Top attractions for each day\nKeep response under 500 words.";
	
	try 
	{
		groq_payload = Map();
		groq_payload.put("model","llama-3.1-8b-instant");
		messages_list = List();
		message_map = Map();
		message_map.put("role","user");
		message_map.put("content",itinerary_prompt);
		messages_list.add(message_map);
		groq_payload.put("messages",messages_list);
		groq_payload.put("max_tokens",700);
		groq_payload.put("temperature",0.7);
		
		groq_response = invokeurl
		[
			url :"https://api.groq.com/openai/v1/chat/completions"
			type :POST
			parameters:groq_payload.toString()
			headers:{"Authorization":"Bearer " + groq_api_key,"Content-Type":"application/json"}
		];
		
		if(groq_response.containsKey("choices") && groq_response.get("choices").size() > 0)
		{
			choice = groq_response.get("choices").get(0);
			if(choice.containsKey("message") && choice.get("message").containsKey("content"))
			{
				itinerary_details = choice.get("message").get("content");
				
				next_context = "custom_itinerary_review__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_code + "__" + num_days;
				
				response.put("action","context");
				response.put("context_id",next_context);
				question = {"name":"itinerary_action","replies":{"🎉 Your Custom " + num_days + "-Day Trip Itinerary is Ready!\n\n📍 Destination: " + destination + "\n👥 Travelers: " + num_travelers + "\n🚍 Transport: " + transport_readable + "\n\n" + itinerary_details + "\n\nWould you like to:"},"suggestions":{"Select this Trip","Edit Itinerary","Start Over"}};
				response.put("questions",{question});
				return response;
			}
		}
	
		next_context = "custom_itinerary_review__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_code + "__" + num_days;
		response.put("action","context");
		response.put("context_id",next_context);
		question = {"name":"itinerary_action","replies":{"🎉 Your Custom Trip Itinerary is Ready!\n\n📍 Destination: " + destination + "\n📅 Duration: " + num_days + " Days\n👥 Travelers: " + num_travelers + "\n\nWould you like to:"},"suggestions":{"Select this Trip","Edit Itinerary","Start Over"}};
		response.put("questions",{question});
		return response;
	}
	catch (e)
	{
		info "Groq Itinerary API Error: " + e;
		next_context = "custom_itinerary_review__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_code + "__" + num_days;
		response.put("action","context");
		response.put("context_id",next_context);
		question = {"name":"itinerary_action","replies":{"🎉 Your Custom Trip Itinerary is Ready!\n\n📍 Destination: " + destination + "\n📅 Duration: " + num_days + " Days\n\nWould you like to:"},"suggestions":{"Select this Trip","Edit Itinerary","Start Over"}};
		response.put("questions",{question});
		return response;
	}
}
// CUSTOM ITINERARY REVIEW HANDLER
if(context_id.startsWith("custom_itinerary_review__"))
{
	if(!answers.containsKey("itinerary_action"))
	{
		question = {"name":"itinerary_action","replies":{"Would you like to:"},"suggestions":{"Select this Trip","Edit Itinerary","Start Over"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	action_choice = answers.get("itinerary_action").get("text");
	parts = context_id.replaceAll("custom_itinerary_review__","").toList("__");
	num_travelers = parts.get(0);
	destination = parts.get(1);
	current_location = parts.get(2);
	transport_mode = parts.get(3);

	num_days = "5"; 
	if(parts.size() >= 5) { num_days = parts.get(4); }
	
	if(action_choice == "Select this Trip")
	{
	
		custom_package_context = "collect_name__post_pricing__CUSTOM__" + destination + "__CustomItinerary__0__" + num_travelers + "__" + current_location + "__" + transport_mode + "__" + num_days;
		response.put("action","context");
		response.put("context_id",custom_package_context);
		question = {"name":"user_name","replies":{"Great! Let's get your contact details to send you the complete itinerary. 📧\n\nPlease enter your Full Name:"},"input":{"type":"name","placeholder":"Your Name"}};
		response.put("questions",{question});
		return response;
	}
	else if(action_choice == "Edit Itinerary")
	{
		edit_context = "custom_edit_select__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_mode + "__" + num_days;
		response.put("action","context");
		response.put("context_id",edit_context);
		question = {"name":"edit_choice","replies":{"What would you like to edit?"},"suggestions":{"Number of Travelers","Destination","Current Location","Transport Mode","Number of Days"}};
		response.put("questions",{question});
		return response;
	}
	else if(action_choice == "Start Over")
	{
		response.put("action","context");
		response.put("context_id","custom_itinerary_start");
		question = {"name":"start_custom","replies":{"Perfect! Let's create a custom itinerary just for you! 🗺️\n\nI'll need some details to plan the perfect trip."},"suggestions":{"Let's Start!"}};
		response.put("questions",{question});
		return response;
	}
	else
	{
		question = {"name":"itinerary_action","replies":{"Please use the buttons to select an option."},"suggestions":{"Select this Trip","Edit Itinerary","Start Over"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
}

// CUSTOM EDIT SELECT HANDLER
if(context_id.startsWith("custom_edit_select__"))
{
	if(!answers.containsKey("edit_choice"))
	{
		question = {"name":"edit_choice","replies":{"What would you like to edit?"},"suggestions":{"Number of Travelers","Destination","Current Location","Transport Mode","Number of Days"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	edit_selection = answers.get("edit_choice").get("text");
	parts = context_id.replaceAll("custom_edit_select__","").toList("__");
	num_travelers = parts.get(0);
	destination = parts.get(1);
	current_location = parts.get(2);
	transport_mode = parts.get(3);
	num_days = "5";
	if(parts.size() >= 5) { num_days = parts.get(4); }
	
	if(edit_selection == "Number of Travelers")
	{
		edit_context = "custom_edit_travelers__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_mode;
		response.put("action","context");
		response.put("context_id",edit_context);
		question = {"name":"new_travelers","replies":{"Current travelers: " + num_travelers + "\n\nEnter new number of travelers (1-20):"},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("questions",{question});
		return response;
	}
	else if(edit_selection == "Destination")
	{
		edit_context = "custom_edit_destination__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_mode;
		response.put("action","context");
		response.put("context_id",edit_context);
		question = {"name":"new_destination","replies":{"Current destination: " + destination + "\n\nEnter new destination:"},"input":{"type":"name","placeholder":"e.g., Paris, Goa, Manali"}};
		response.put("questions",{question});
		return response;
	}
	else if(edit_selection == "Current Location")
	{
		edit_context = "custom_edit_location__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_mode;
		response.put("action","context");
		response.put("context_id",edit_context);
		question = {"name":"new_location","replies":{"Current location: " + current_location + "\n\nEnter new location:"},"input":{"type":"name","placeholder":"e.g., Delhi, Mumbai, Bangalore"}};
		response.put("questions",{question});
		return response;
	}
	else if(edit_selection == "Transport Mode")
	{
	
		next_context = "custom_transport_choice__" + num_travelers + "__" + destination + "__" + current_location;
		response.put("action","context");
		response.put("context_id",next_context);
		question = {"name":"transport_choice","replies":{"Select new transport mode:"},"suggestions":{"Public Transport","Private Transport"}};
		response.put("questions",{question});
		return response;
	}
	else if(edit_selection == "Number of Days")
	{
	
		transport_readable = "Private Transport";
		if(transport_mode == "PublicTransport") { transport_readable = "Public Transport"; }
		
		next_context = "custom_days_selection__" + num_travelers + "__" + destination + "__" + current_location + "__" + transport_mode;
		response.put("action","context");
		response.put("context_id",next_context);
		question = {"name":"trip_days","replies":{"Current duration: " + num_days + " days\n\nEnter new duration (1-30 days):"},"input":{"type":"name","placeholder":"e.g., 7"}};
		response.put("questions",{question});
		return response;
	}
}

// EDIT TRAVELERS HANDLER
if(context_id.startsWith("custom_edit_travelers__"))
{
	if(!answers.containsKey("new_travelers"))
	{
		question = {"name":"new_travelers","replies":{"Enter new number of travelers (1-20):"},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	parts = context_id.replaceAll("custom_edit_travelers__","").toList("__");
	old_travelers = parts.get(0);
	destination = parts.get(1);
	current_location = parts.get(2);
	transport_mode = parts.get(3);
	new_travelers_text = answers.get("new_travelers").get("text");
	try 
	{
		new_travelers = new_travelers_text.toNumber();
	}
	catch (e)
	{
		question = {"name":"new_travelers","replies":{"Please enter a valid number (e.g., 4)"},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	if(new_travelers < 1 || new_travelers > 20)
	{
		question = {"name":"new_travelers","replies":{"Please enter a number between 1 and 20."},"input":{"type":"name","placeholder":"e.g., 4"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}

	next_context = "custom_transport_choice__" + new_travelers + "__" + destination + "__" + current_location;
	response.put("action","context");
	response.put("context_id",next_context);
	question = {"name":"transport_choice","replies":{"✅ Updated travelers: " + new_travelers + "\n\nRecalculating itinerary...\n\n🚗 How would you like to travel?"},"suggestions":{"Public Transport","Private Transport"}};
	response.put("questions",{question});
	return response;
}

