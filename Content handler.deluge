					email_payload.put("from",from_map);
					email_payload.put("subject","🎉 Booking Confirmed - " + pkg_title + " | " + booking_id);
					html_content = "<div style='font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; background: #f5f5f5;'>" + "<div style='background: linear-gradient(135deg, #0066cc 0%, #004a99 100%); padding: 30px 20px; text-align: center;'>" + "<div style='display: inline-block; margin-bottom: 10px;'>🧳</div>" + "<h1 style='color: white; margin: 0; font-size: 28px;'>TravelMate</h1>" + "<p style='color: #e0e0e0; margin: 5px 0 0 0; font-size: 14px;'>Your Journey Begins Here</p>" + "</div>" + "<div style='background: #4CAF50; padding: 15px; text-align: center;'>" + "<h2 style='color: white; margin: 0; font-size: 20px;'>✅ Booking Confirmed!</h2>" + "<p style='color: white; margin: 5px 0 0 0; font-size: 13px;'>Your trip is all set. Get ready for an amazing adventure!</p>" + "</div>" + "<div style='background: white; padding: 20px;'>" + "<p style='font-size: 15px; color: #333; margin: 0 0 20px 0;'>Dear <strong>" + user_name + "</strong>,</p>" + "<p style='font-size: 14px; color: #666; margin: 0 0 20px 0;'>Thank you for choosing TravelMate! We're excited to be part of your travel journey. Your booking has been confirmed and we're here for everything for your upcoming trip.</p>" + "<div style='background: #f9f9f9; border-left: 4px solid #0066cc; padding: 15px; margin-bottom: 25px;'>" + "<p style='margin: 0; font-size: 12px; color: #999; text-transform: uppercase; letter-spacing: 1px;'>Booking Reference</p>" + "<p style='margin: 5px 0 0 0; font-size: 24px; color: #0066cc; font-weight: bold; letter-spacing: 1px;'>" + booking_id + "</p>" + "</div>" + "<div style='border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; margin-bottom: 25px;'>" + "<div style='background: #f8f8f8; padding: 12px 15px; border-bottom: 1px solid #e0e0e0;'>" + "<h3 style='margin: 0; font-size: 16px; color: #333;'>📋 Trip Details</h3>" + "</div>" + "<table style='width: 100%; border-collapse: collapse;'>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px; width: 40%;'>📍 Destination</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + destination + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>📦 Package</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + pkg_title + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>🎒 Trip Type</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + trip_type + "</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>👥 Members</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + member_count + " Member(s)</td>" + "</tr>" + "<tr style='border-bottom: 1px solid #f0f0f0;'>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>📅 Travel Date</td>" + "<td style='padding: 12px 15px; color: #333; font-size: 14px; font-weight: 500; text-align: right;'>" + travel_date + "</td>" + "</tr>" + "<tr>" + "<td style='padding: 12px 15px; color: #666; font-size: 14px;'>💰 Total Amount</td>" + "<td style='padding: 12px 15px; color: #0066cc; font-size: 16px; font-weight: bold; text-align: right;'>₹" + final_price + "</td>" + "</tr>" + "</table>" + "</div>" + "<div style='background: #fffbf0; border: 1px solid #ffe082; border-radius: 8px; padding: 15px; margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 10px 0; font-size: 15px; color: #f57c00;'>✨ Package Highlights</h3>" + "<p style='margin: 0 0 8px 0; font-size: 13px; color: #666;'><strong>🗺️ Sightseeing:</strong> " + pkg_desc + "</p>" + "<p style='margin: 0; font-size: 13px; color: #666;'><strong>🏨 Accommodation:</strong> " + pkg_hotel + "</p>" + "</div>" + "<div style='background: #fff9e6; border: 1px solid #ffe082; border-radius: 8px; padding: 15px; margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 10px 0; font-size: 15px; color: #f57c00;'>📞 Your Contact Information</h3>" + "<p style='margin: 0 0 5px 0; font-size: 13px; color: #666;'>📧 <strong>Email:</strong> " + user_email + "</p>" + "<p style='margin: 0; font-size: 13px; color: #666;'>📱 <strong>Phone:</strong> " + user_phone + "</p>" + "</div>" + "<div style='background: #e3f2fd; border-left: 4px solid #2196F3; padding: 12px 15px; margin-bottom: 25px;'>" + "<p style='margin: 0; font-size: 13px; color: #1565C0;'><strong>💡 Important:</strong> Please keep this booking reference handy. Our team will contact you shortly with complete itinerary and travel documents.</p>" + "</div>" + "<div style='margin-bottom: 25px;'>" + "<h3 style='margin: 0 0 12px 0; font-size: 16px; color: #333;'>🔔 What's Next?</h3>" + "<ul style='margin: 0; padding-left: 20px; color: #666; font-size: 13px; line-height: 1.8;'>" + "<li>Our travel expert will call you within 24 hours</li>" + "<li>You'll receive detailed itinerary via email</li>" + "<li>Complete travel documents will be shared</li>" + "<li>24/7 support available throughout your journey</li>" + "</ul>" + "</div>" + "<div style='text-align: center; margin-bottom: 20px;'>" + "<a href='mailto:travelmate003004@gmail.com' style='display: inline-block; background: #0066cc; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; font-size: 14px; font-weight: bold;'>Contact Support</a>" + "</div>" + "<p style='font-size: 13px; color: #666; text-align: center; margin: 0;'>We're thrilled to be part of your travel experience and committed to making it memorable. Safe travels!</p>" + "</div>" + "<div style='background: #333; padding: 20px; text-align: center;'>" + "<p style='margin: 0 0 5px 0; font-size: 13px; color: #999;'>Warm regards,</p>" + "<p style='margin: 0; font-size: 14px; color: white; font-weight: bold;'>Team TravelMate 🧳✈️</p>" + "<p style='margin: 15px 0 0 0; font-size: 11px; color: #666;'>This is an automated confirmation email. Please do not reply to this email.</p>" + "<p style='margin: 3px 0 0 0; font-size: 11px; color: #666;'>© 2025 TravelMate. All rights reserved.</p>" + "</div>" + "</div>";
					content_list = List();
					content_map = Map();
					content_map.put("type","text/html");
					content_map.put("value",html_content);
					content_list.add(content_map);
					email_payload.put("content",content_list);
					confirmation_response = invokeurl
					[
						url :"https://api.sendgrid.com/v3/mail/send"
						type :POST
						parameters:email_payload.toString()
						headers:{"Authorization":"Bearer " + sendgrid_api_key,"Content-Type":"application/json"}
					];
					info "Booking confirmation email sent successfully to: " + user_email;
				}
				catch (e)
				{
					info "Email sending error: " + e;
				}
				post_booking_context = "post_booking_options__BOOKINGID:" + booking_id + "||EMAIL:" + user_email + "||NAME:" + user_name + "||TRAVELDATE:" + travel_date + "||DESTINATION:" + destination + "||MEMBERCOUNT:" + member_count + "||FINALPRICE:" + final_price + "||PKGTITLE:" + pkg_title + "||PKGDESC:" + pkg_desc + "||PKGHOTEL:" + pkg_hotel + "||TRIPTYPE:" + trip_type + "||PHONE:" + user_phone;
				response.put("action","context");
				response.put("context_id",post_booking_context);
				question = {"name":"post_booking_choice","replies":{{"text":"🎉 Payment Verified! Your booking is confirmed!\n\n📧 Booking confirmation sent to " + user_email + "\n\n🎫 Booking ID: " + booking_id + "\n📅 Travel Date: " + travel_date + "\n\n✈️ Our team will contact you shortly. Have a wonderful trip!"},{"text":"How can I help you further?"}},"suggestions":{"Send me my trip details to my email again.","Want to explore again! Click here.","End chat"}};
				response.put("questions",{question});
				return response;
			}
		}
	}
	else
	{
		question = {"name":"payment_done","replies":{"Please type \"Done\" once you finish the payment, or type \"Cancel Payment\" to cancel."},"input":{"type":"name","placeholder":"Type Done"},"suggestions":{"Done","Cancel Payment"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
}
//PAYMENT RETRY
if(context_id.startsWith("payment_retry__"))
{
	if(!answers.containsKey("retry_payment"))
	{
		question = {"name":"retry_payment","replies":{"Please choose an option."},"suggestions":{"Verify Again","Retry Payment"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	retry_choice = answers.get("retry_payment").get("text");
	if(retry_choice == "Verify Again")
	{
		original_context = context_id.replaceAll("payment_retry__","");
		response.put("action","context");
		response.put("context_id",original_context);
		question = {"name":"payment_done","replies":{"Let's verify your payment again.\n\nPlease type \"Done\" to check payment status."},"input":{"type":"name","placeholder":"Type Done"},"suggestions":{"Done","Cancel Payment"}};
		response.put("questions",{question});
		return response;
	}
	else if(retry_choice == "Retry Payment")
	{
		original_context = context_id.replaceAll("payment_retry__","");
		parts = original_context.toList("__");
		if(parts.size() >= 3)
		{
			old_order_id = parts.get(1);
			old_payment_link_id = parts.get(2);
			try 
			{
				auth_string = razorpay_key_id + ":" + razorpay_key_secret;
				auth_header = "Basic " + zoho.encryption.base64Encode(auth_string);
				cancel_payload = Map();
				cancel_response = invokeurl
				[
					url :"https://api.razorpay.com/v1/payment_links/" + old_payment_link_id + "/cancel"
					type :POST
					parameters:cancel_payload.toString()
					headers:{"Authorization":auth_header,"Content-Type":"application/json"}
				];
				info "Cancelled old payment link: " + old_payment_link_id;
			}
			catch (e)
			{
				info "Error cancelling payment link (may already be expired): " + e;
			}
			base_context = original_context.subString(original_context.indexOf("__",original_context.indexOf("__") + 2) + 2);
			final_price = "0";
			if(base_context.contains("post_pricing__INDIA__"))
			{
				pricing_start = base_context.indexOf("post_pricing__INDIA__") + 21;
				pricing_end = base_context.indexOf("||NAME",pricing_start);
				if(pricing_end == -1)
				{
					pricing_end = base_context.length();
				}
				pricing_part = base_context.subString(pricing_start,pricing_end);
				parts_temp = pricing_part.toList("__");
				if(parts_temp.size() >= 3)
				{
					final_price = parts_temp.get(2);
				}
			}
			else if(base_context.contains("post_pricing__INTL__"))
			{
				pricing_start = base_context.indexOf("post_pricing__INTL__") + 20;
				pricing_end = base_context.indexOf("||NAME",pricing_start);
				if(pricing_end == -1)
				{
					pricing_end = base_context.length();
				}
				pricing_part = base_context.subString(pricing_start,pricing_end);
				parts_temp = pricing_part.toList("__");
				if(parts_temp.size() >= 3)
				{
					final_price = parts_temp.get(2);
				}
			}
			test_amount = 1;
			amount_in_paise = test_amount * 100;
			receipt_id = "TMRECEIPT" + zoho.currenttime.toString("yyyyMMddHHmmss");
			auth_string = razorpay_key_id + ":" + razorpay_key_secret;
			auth_header = "Basic " + zoho.encryption.base64Encode(auth_string);
			try 
			{
				payment_link_payload = Map();
				payment_link_payload.put("amount",amount_in_paise);
				payment_link_payload.put("currency","INR");
				payment_link_payload.put("accept_partial",false);
				payment_link_payload.put("reference_id",receipt_id);
				payment_link_payload.put("description","TravelMate Retry - Package: ₹" + final_price + " (Test Mode: Pay ₹1 only)");
				payment_link_payload.put("customer",{"name":"Customer","email":"","contact":""});
				payment_link_payload.put("notify",{"sms":false,"email":false});
				payment_link_payload.put("reminder_enable",false);
				payment_link_payload.put("callback_url","https://yourdomain.com/payment-success");
				payment_link_payload.put("callback_method","get");
				notes_map = Map();
				notes_map.put("package_amount",final_price);
				notes_map.put("test_mode","true");
				notes_map.put("booking_type","TravelMate Retry");
				payment_link_payload.put("notes",notes_map);
				payment_link_response = invokeurl
				[
					url :"https://api.razorpay.com/v1/payment_links"
					type :POST
					parameters:payment_link_payload.toString()
					headers:{"Authorization":auth_header,"Content-Type":"application/json"}
				];
				if(payment_link_response.containsKey("short_url"))
				{
					payment_url = payment_link_response.get("short_url");
					new_payment_link_id = payment_link_response.get("id");
					new_order_id = payment_link_response.get("order_id");
					response.put("action","context");
					response.put("context_id","await_payment__" + new_order_id + "__" + new_payment_link_id + "__" + base_context);
					question = {"name":"payment_done","replies":{{"text":"🔄 New payment link generated!\n\n❌ Previous order cancelled: " + old_order_id},{"text":"💳 Payment Link:\n" + payment_url},{"text":"📦 Package Amount: ₹" + final_price + "\n💰 Test Payment: ₹1 only\n\n⚠️ *Testing Mode Active*\n\nAfter completing payment, type \"Done\" to verify.\n\nOr type \"Cancel Payment\" to cancel."}},"input":{"type":"name","placeholder":"Type Done"},"suggestions":{"Done","Cancel Payment"}};
					response.put("questions",{question});
					return response;
				}
				else
				{
					response.put("action","reply");
					response.put("replies",{"❌ Unable to create new payment link. Please contact support.\n\nCancelled Order: " + old_order_id});
					return response;
				}
			}
			catch (e)
			{
				info "Retry Payment Link Creation Error: " + e;
				response.put("action","reply");
				response.put("replies",{"❌ Payment system error during retry. Please contact support.\n\nError: " + e + "\n\nCancelled Order: " + old_order_id});
				return response;
			}
		}
	}
}
// PAYMENT CANCELLED
if(context_id.startsWith("payment_cancelled__"))
{
	if(!answers.containsKey("after_cancel_choice"))
	{
		question = {"name":"after_cancel_choice","replies":{"What would you like to do?"},"suggestions":{"Retry Payment","End Chat"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	choice = answers.get("after_cancel_choice").get("text");
	if(choice == "Retry Payment")
	{
		parts = context_id.toList("__");
		if(parts.size() >= 3)
		{
			cancelled_order_id = parts.get(1);
			base_context = context_id.subString(context_id.indexOf("__",context_id.indexOf("__") + 2) + 2);
			final_price = "0";
			if(base_context.contains("post_pricing__INDIA__"))
			{
				pricing_start = base_context.indexOf("post_pricing__INDIA__") + 21;
				pricing_end = base_context.indexOf("||NAME",pricing_start);
				if(pricing_end == -1)
				{
					pricing_end = base_context.length();
				}
				pricing_part = base_context.subString(pricing_start,pricing_end);
				parts_temp = pricing_part.toList("__");
				if(parts_temp.size() >= 3)
				{
					final_price = parts_temp.get(2);
				}
			}
			else if(base_context.contains("post_pricing__INTL__"))
			{
				pricing_start = base_context.indexOf("post_pricing__INTL__") + 20;
				pricing_end = base_context.indexOf("||NAME",pricing_start);
				if(pricing_end == -1)
				{
					pricing_end = base_context.length();
				}
				pricing_part = base_context.subString(pricing_start,pricing_end);
				parts_temp = pricing_part.toList("__");
				if(parts_temp.size() >= 3)
				{
					final_price = parts_temp.get(2);
				}
			}
			test_amount = 1;
			amount_in_paise = test_amount * 100;
			receipt_id = "TMRECEIPT" + zoho.currenttime.toString("yyyyMMddHHmmss");
			auth_string = razorpay_key_id + ":" + razorpay_key_secret;
			auth_header = "Basic " + zoho.encryption.base64Encode(auth_string);
			try 
			{
				payment_link_payload = Map();
				payment_link_payload.put("amount",amount_in_paise);
				payment_link_payload.put("currency","INR");
				payment_link_payload.put("accept_partial",false);
				payment_link_payload.put("reference_id",receipt_id);
				payment_link_payload.put("description","TravelMate After Cancel - Package: ₹" + final_price + " (Test Mode: Pay ₹1 only)");
				payment_link_payload.put("customer",{"name":"Customer","email":"","contact":""});
				payment_link_payload.put("notify",{"sms":false,"email":false});
				payment_link_payload.put("reminder_enable",false);
				payment_link_payload.put("callback_url","https://yourdomain.com/payment-success");
				payment_link_payload.put("callback_method","get");
				notes_map = Map();
				notes_map.put("package_amount",final_price);
				notes_map.put("test_mode","true");
				notes_map.put("booking_type","TravelMate After Cancel");
				payment_link_payload.put("notes",notes_map);
				payment_link_response = invokeurl
				[
					url :"https://api.razorpay.com/v1/payment_links"
					type :POST
					parameters:payment_link_payload.toString()
					headers:{"Authorization":auth_header,"Content-Type":"application/json"}
				];
				if(payment_link_response.containsKey("short_url"))
				{
					payment_url = payment_link_response.get("short_url");
					new_payment_link_id = payment_link_response.get("id");
					new_order_id = payment_link_response.get("order_id");
					response.put("action","context");
					response.put("context_id","await_payment__" + new_order_id + "__" + new_payment_link_id + "__" + base_context);
					question = {"name":"payment_done","replies":{{"text":"🔄 New payment link generated!\n\n❌ Previous order cancelled: " + cancelled_order_id},{"text":"💳 Payment Link:\n" + payment_url},{"text":"📦 Package Amount: ₹" + final_price + "\n💰 Test Payment: ₹1 only\n\n⚠️ *Testing Mode Active*\n\nAfter completing payment, type \"Done\" to verify.\n\nOr type \"Cancel Payment\" to cancel."}},"input":{"type":"name","placeholder":"Type Done"},"suggestions":{"Done","Cancel Payment"}};
					response.put("questions",{question});
					return response;
				}
				else
				{
					response.put("action","reply");
					response.put("replies",{"❌ Unable to create new payment link. Please contact support.\n\nCancelled Order: " + cancelled_order_id});
					return response;
				}
			}
			catch (e)
			{
				info "Retry Payment Link Creation Error: " + e;
				response.put("action","reply");
				response.put("replies",{"❌ Payment system error during retry. Please contact support.\n\nError: " + e});
				return response;
			}
		}
	}
	else if(choice == "End Chat")
	{
		response.put("action","reply");
		response.put("replies",{"Thank you for considering TravelMate! 🧳\n\nIf you change your mind, feel free to return anytime.\n\nType 'Hi' to start a new booking.\n\nHave a great day! 😊"});
		return response;
	}
	else
	{
		question = {"name":"after_cancel_choice","replies":{"Please use the buttons to select an option."},"suggestions":{"Retry Payment","End Chat"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
}
// POST-BOOKING OPTIONS
if(context_id.startsWith("post_booking_options"))
{
	if(!answers.containsKey("post_booking_choice"))
	{
		question = {"name":"post_booking_choice","replies":{"How can I help you further?"},"suggestions":{"Send me my trip details to my email again.","Want to explore again! Click here.","End chat"}};
		response.put("action","context");
		response.put("context_id",context_id);
		response.put("questions",{question});
		return response;
	}
	choice = answers.get("post_booking_choice").get("text");
	if(choice == "Send me my trip details to my email again.")
	{
		user_email = "N/A";
		user_name = "N/A";
		user_phone = "N/A";
		booking_id = "N/A";
		destination = "Unknown";
		travel_date = "TBD";
		member_count = "1";
		final_price = "0";
		pkg_title = "Travel Package";
		pkg_desc = "Exciting destinations";
		pkg_hotel = "Comfortable stay";
		trip_type = "Standard";
		if(context_id.contains("BOOKINGID:"))
		{
