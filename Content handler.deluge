//HANDLE INDIA PACKAGE SELECTION FROM CAROUSEL
if(context_id.startsWith("india_carousel__"))
{

	selected_action = "";
	if(answers.containsKey("india_carousel_selection"))
	{

		selected_action = answers.get("india_carousel_selection").get("name");
		
		if(selected_action == null || selected_action == "")
		{
			selection_text = answers.get("india_carousel_selection").get("text");
			
			if(selection_text.contains("Goa") || selection_text.contains("Sun & Sand")) { selected_action = "BookGoa"; }
			else if(selection_text.contains("Kerala") || selection_text.contains("Bliss")) { selected_action = "BookKerala"; }
			else if(selection_text.contains("Kashmir") || selection_text.contains("Heaven")) { selected_action = "BookKashmir"; }
			else if(selection_text.contains("Manali") || selection_text.contains("Snow")) { selected_action = "BookManali"; }
			else if(selection_text.contains("Ladakh") || selection_text.contains("Adventure")) { selected_action = "BookLadakh"; }
			else if(selection_text.contains("Jaipur") || selection_text.contains("Rajasthan")) { selected_action = "BookJaipur"; }
		}
	}
	
	if(selected_action == "" || selected_action == null)
	{
		if(answers.containsKey("BookGoa")) { selected_action = "BookGoa"; }
		else if(answers.containsKey("BookKerala")) { selected_action = "BookKerala"; }
		else if(answers.containsKey("BookKashmir")) { selected_action = "BookKashmir"; }
		else if(answers.containsKey("BookManali")) { selected_action = "BookManali"; }
		else if(answers.containsKey("BookLadakh")) { selected_action = "BookLadakh"; }
		else if(answers.containsKey("BookJaipur")) { selected_action = "BookJaipur"; }
	}
	
	if(selected_action == "")
	{
		response.put("action","reply");
		response.put("replies",{"Please select a package from the carousel."});
		return response;
	}
	
	parts = context_id.replaceAll("india_carousel__","").toList("__");
	trip_type = parts.get(0);
	member_count = parts.get(1).toNumber();
	
	place = "";
	pkg_title = "";
	pkg_image = "";
	pkg_duration = "";
	pkg_sightseeing = "";
	pkg_stay = "";
	pkg_meals = "";
	base_price = 0;
	
	if(selected_action == "BookGoa")
	{
		place = "Goa";
		pkg_title = "Goa Sun & Sand";
		pkg_duration = "3N/4D";
		pkg_sightseeing = "North Goa Beaches, Fort Aguada, Sunset Cruise";
		pkg_stay = "3★ Beach Resort (Breakfast)";
		pkg_meals = "2 Meals/day included";
		base_price = 24999;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/goa%20image.jpeg";
	}
	else if(selected_action == "BookKerala")
	{
		place = "Kerala";
		pkg_title = "Kerala Bliss";
		pkg_duration = "4N/5D";
		pkg_sightseeing = "Munnar Hills, Alleppey Houseboat, Tea Gardens";
		pkg_stay = "Hill Resort + Houseboat";
		pkg_meals = "All meals included";
		base_price = 31999;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/kerala%20image.jpeg";
	}
	else if(selected_action == "BookKashmir")
	{
		place = "Kashmir";
		pkg_title = "Heaven on Earth";
		pkg_duration = "4N/5D";
		pkg_sightseeing = "Dal Lake, Gulmarg, Pahalgam, Srinagar";
		pkg_stay = "Houseboat + 3★ Hotel";
		pkg_meals = "Breakfast & Dinner";
		base_price = 34999;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/kashmir%20image.jpeg";
	}
	else if(selected_action == "BookManali")
	{
		place = "Manali";
		pkg_title = "Snow Retreat";
		pkg_duration = "3N/4D";
		pkg_sightseeing = "Solang Valley, Rohtang Pass, Atal Tunnel";
		pkg_stay = "Mountain View Hotel";
		pkg_meals = "Breakfast included";
		base_price = 19999;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/manali%20image.jpeg";
	}
	else if(selected_action == "BookLadakh")
	{
		place = "Ladakh";
		pkg_title = "Ladakh Adventure";
		pkg_duration = "5N/6D";
		pkg_sightseeing = "Leh, Pangong Lake, Nubra Valley, Khardung La";
		pkg_stay = "Luxury Camps + Hotel";
		pkg_meals = "All meals included";
		base_price = 45999;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/ladakh%20image.jpeg";
	}
	else if(selected_action == "BookJaipur")
	{
		place = "Jaipur";
		pkg_title = "Royal Rajasthan";
		pkg_duration = "3N/4D";
		pkg_sightseeing = "Amber Fort, City Palace, Hawa Mahal, Jantar Mantar";
		pkg_stay = "Heritage Haveli";
		pkg_meals = "Breakfast + 1 Royal Dinner";
		base_price = 22999;
		pkg_image = "https://raw.githubusercontent.com/K-Mokshagna/TravelMate-images/main/jaipur%20image.jpeg";
	}
	
	final_price = base_price * member_count;
	pkg_details = pkg_duration + " • ₹" + final_price + " total\n\n📍 " + pkg_sightseeing + "\n🏨 " + pkg_stay + "\n🍴 " + pkg_meals + "\n👥 " + member_count + " member(s)";
	
	next_context = "post_pricing__INDIA__" + place + "__" + trip_type + "__" + final_price + "__" + member_count;
	response.put("action","context");
	response.put("context_id",next_context);
	
	question = {"name":"post_price_confirmation","replies":{{"type":"image","image":pkg_image,"text":pkg_title},{"text":pkg_details},{"text":"Would you like to proceed with booking?"}},"suggestions":{"Continue Booking","Cancel"}};
	response.put("questions",{question});
	return response;
}

